{
  "type": "record",
  "namespace": "CosmosGenesis.cosmic_phenomena",
  "name": "PrimordialBlackHole",
  "doc": "Represents properties of primordial black holes.",
  "fields": [
    {
      "name": "pbh_designation",
      "type": "string",
      "default": ""
    },
    {
      "name": "formation_time_s",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "age_myr",
      "type": "double",
      "default": 0.0,
      "doc": "Age of the primordial black hole in Myr (universe_time - formation_time)"
    },
    {
      "name": "initial_mass_g",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "current_mass_g",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "hawking_temperature_k",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "evaporation_rate_g_s",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "remaining_lifetime_s",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "emission_spectrum",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "RadiationComponent",
          "fields": [
            {
              "name": "particle_type",
              "type": "string",
              "default": ""
            },
            {
              "name": "energy_spectrum",
              "type": {
                "type": "array",
                "items": "double"
              },
              "default": []
            },
            {
              "name": "emission_rate",
              "type": "double",
              "default": 0.0
            }
          ]
        }
      },
      "default": []
    },
    {
      "name": "clustering_parameter",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "density_fraction",
      "type": "double",
      "default": 0.0
    },
    {
      "name": "galaxy_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Identifier of the galaxy this primordial black hole belongs to"
    },
    {
      "name": "coordinates",
      "type": "CosmosGenesis.properties.Coordinates"
    },
    {
      "name": "universe_time",
      "type": "long",
      "default": 0,
      "doc": "Universe time in Myr when this primordial black hole state was recorded (for aging/time-travel)"
    }
  ],
  "version": "1.3.0"
}
