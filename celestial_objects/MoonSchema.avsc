{
  "type": "record",
  "namespace": "CosmosGenesis.celestial_objects",
  "name": "Moon",
  "doc": "Represents a single natural satellite orbiting a planet.",
  "version": "1.0.0",
  "fields": [
    {
      "name": "galaxy_id",
      "type": "string",
      "doc": "Identifier of the galaxy this moon belongs to",
      "default": ""
    },
    {
      "name": "system_id",
      "type": "string",
      "doc": "Identifier of the star system that contains the parent planet",
      "default": ""
    },
    {
      "name": "star_id",
      "type": "string",
      "doc": "Identifier of the parent star of the parent planet",
      "default": ""
    },
    {
      "name": "planet_id",
      "type": "string",
      "doc": "Identifier of the parent planet this moon orbits",
      "default": ""
    },
    {
      "name": "moon_id",
      "type": "string",
      "doc": "Stable identifier for this moon within the data lake",
      "default": ""
    },
    {
      "name": "moon_designation",
      "type": "string",
      "default": ""
    },
    {
      "name": "parent_planet_designation",
      "type": "string",
      "default": ""
    },
    {
      "name": "moon_type",
      "type": "CosmosGenesis.properties.MoonType"
    },
    {
      "name": "mass_lm",
      "type": "double",
      "doc": "Mass in Lunar Masses (Earth's Moon = 1.0).",
      "default": 0.0
    },
    {
      "name": "radius_lr",
      "type": "double",
      "doc": "Radius in Lunar Radii (Earth's Moon = 1.0).",
      "default": 0.0
    },
    {
      "name": "is_tidally_locked",
      "type": "boolean",
      "default": true
    },
    {
      "name": "rotation_period_hours",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Rotation period in hours. For tidally locked moons, this equals the orbital period. Negative values indicate retrograde rotation."
    },
    {
      "name": "axial_tilt_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Axial tilt (obliquity) in degrees relative to the moon's orbital plane (0-180°). Tidally locked moons typically have low axial tilts."
    },
    {
      "name": "orbital_distance_km",
      "type": "double",
      "doc": "Average orbital distance from the parent planet in kilometers.",
      "default": 0.0
    },
    {
      "name": "orbital_period_days",
      "type": "double",
      "doc": "The number of Earth days it takes to orbit the parent planet.",
      "default": 0.0
    },
    {
      "name": "eccentricity",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Orbital eccentricity (0 = circular, 0-1 = elliptical)"
    },
    {
      "name": "inclination_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Orbital inclination in degrees relative to parent planet's equator"
    },
    {
      "name": "mean_anomaly_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Mean anomaly at epoch in degrees"
    },
    {
      "name": "longitude_of_ascending_node_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Longitude of ascending node in degrees"
    },
    {
      "name": "argument_of_periapsis_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Argument of periapsis in degrees"
    },
    {
      "name": "coordinates",
      "type": "CosmosGenesis.properties.Coordinates"
    },
    {
      "name": "age_myr",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Age of the moon since formation in millions of years"
    },
    {
      "name": "semi_major_axis_au",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Orbital semi-major axis in AU (computed from orbital_distance_km for physics models)"
    },
    {
      "name": "universe_time",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Universe time in Myr when this state was recorded (for temporal tracking)"
    },
    {
      "name": "albedo",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Bond albedo (0.0–1.0). Icy moons: 0.60–0.99 (Enceladus 0.99, Europa 0.64). Rocky moons: 0.05–0.15 (Phobos 0.07, Luna 0.12). Mixed: 0.15–0.40."
    },
    {
      "name": "surface_temperature_k",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Mean surface temperature in Kelvin. Derived from parent star luminosity and orbital distance; tidally heated moons (IO_VOLCANIC) use an additional tidal flux term."
    },
    {
      "name": "atmosphere_type",
      "type": [
        "null",
        "CosmosGenesis.properties.AtmosphereType"
      ],
      "default": null,
      "doc": "Atmospheric composition class. TITAN_SMOG moons: THICK. IO_VOLCANIC moons: TOXIC (SO₂). EUROPA_OCEAN, TRITON_CRYCVOLCANIC: THIN. All others: NONE."
    },
    {
      "name": "composition_class",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Surface composition category: 'rocky' (silicate/metal dominated), 'icy' (water/ammonia ice dominated), or 'mixed' (significant fractions of both). Drives albedo ranges and shader surface tinting."
    },
    {
      "name": "ocean_coverage",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Fraction of the moon surface covered by liquid (0.0–1.0). Non-zero for europa_ocean (subsurface water ocean beneath ice shell) and triton_cryovolcanic (trace liquid surface patches)."
    },
    {
      "name": "ocean_type",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Chemical composition of the surface or subsurface liquid. One of: water, methane, liquid_nitrogen, sulfuric_acid, brine, liquid_co2. Null when ocean_coverage is null or 0 (SURF-1)."
    }
  ]
}
