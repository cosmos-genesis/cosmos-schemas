{
  "type": "record",
  "namespace": "CosmosGenesis.celestial_objects",
  "name": "AsteroidBelt",
  "doc": "Represents a distinct belt of asteroids or debris within a star system.",
  "version": "1.0.0",
  "fields": [
    {
      "name": "galaxy_id",
      "type": "string",
      "doc": "Identifier of the galaxy this belt belongs to",
      "default": ""
    },
    {
      "name": "system_id",
      "type": "string",
      "doc": "Identifier of the star system that contains this belt",
      "default": ""
    },
    {
      "name": "belt_id",
      "type": "string",
      "doc": "Stable identifier for this asteroid belt within the data lake",
      "default": ""
    },
    {
      "name": "belt_designation",
      "type": "string",
      "doc": "The common name for the belt, e.g., 'Main Belt'.",
      "default": ""
    },
    {
      "name": "belt_type",
      "type": "CosmosGenesis.properties.BeltType",
      "doc": "The classification of the belt."
    },
    {
      "name": "inner_radius_au",
      "type": "double",
      "doc": "The inner edge of the belt in Astronomical Units (AU).",
      "default": 0.0
    },
    {
      "name": "outer_radius_au",
      "type": "double",
      "doc": "The outer edge of the belt in Astronomical Units (AU).",
      "default": 0.0
    },
    {
      "name": "total_mass_em",
      "type": "double",
      "doc": "The total estimated mass of the belt in Earth Masses.",
      "default": 0.0
    },
    {
      "name": "dominant_composition",
      "type": "CosmosGenesis.properties.CompositionType",
      "doc": "The primary material composition of the belt."
    },
    {
      "name": "resources",
      "type": {
        "type": "array",
        "items": "string"
      },
      "doc": "A list of specific, mineable resource keys.",
      "default": []
    },
    {
      "name": "coordinates",
      "type": "CosmosGenesis.properties.Coordinates"
    },
    {
      "name": "belt_age_myr",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Age of the asteroid belt in millions of years (Myr)"
    },
    {
      "name": "parent_star_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "ID of the star this belt orbits (for single star systems or S-TYPE configuration)"
    },
    {
      "name": "orbital_configuration",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Type of orbit: S_TYPE (single star), P_TYPE (binary barycenter), CIRCUMTRIPLE (trinary system barycenter), S_TYPE_BINARY_PAIR (inner binary in trinary)"
    },
    {
      "name": "semi_major_axis_au",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Mean orbital radius of the belt center in AU"
    },
    {
      "name": "eccentricity",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Orbital eccentricity of the belt as a whole (0.0-0.3 typical)"
    },
    {
      "name": "inclination_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Orbital inclination of the belt plane in degrees relative to system plane"
    },
    {
      "name": "longitude_ascending_node_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Longitude of ascending node in degrees (0-360)"
    },
    {
      "name": "argument_periapsis_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Argument of periapsis in degrees (0-360)"
    },
    {
      "name": "mean_anomaly_deg",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Mean anomaly in degrees (0-360) - position along orbit"
    },
    {
      "name": "asteroid_count",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Actual count of named asteroids contained in this belt (not estimated particle count)"
    },
    {
      "name": "universe_time",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Universe time in Myr when this state was recorded (for temporal tracking)"
    }
  ]
}
