{
  "type": "record",
  "namespace": "CosmosGenesis.celestial_objects",
  "name": "Galaxy",
  "doc": "Represents a galaxy containing multiple star systems.",
  "fields": [
    {
      "name": "galaxy_id",
      "type": "string",
      "doc": "Unique run identifier (UUID) for this generation — stable partition key, unique per run",
      "default": ""
    },
    {
      "name": "galaxy_name",
      "type": "string",
      "doc": "User-provided name for the galaxy (e.g. 'Milky Way'). Drives all deterministic seeding — same name + seed always reproduces the same output across multiple runs.",
      "default": ""
    },
    {
      "name": "galaxy_type",
      "type": {
        "type": "enum",
        "name": "GalaxyType",
        "symbols": [
          "SPIRAL",
          "ELLIPTICAL",
          "IRREGULAR",
          "LENTICULAR"
        ]
      },
      "doc": "The morphological classification of the galaxy",
      "default": "SPIRAL"
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "GalaxyStatus",
        "symbols": [
          "GENERATING",
          "COMPLETE",
          "FAILED"
        ]
      },
      "doc": "Generation status: GENERATING (in progress), COMPLETE (finished), FAILED (error occurred)",
      "default": "COMPLETE"
    },
    {
      "name": "properties",
      "type": {
        "type": "record",
        "name": "GalaxyProperties",
        "fields": [
          {
            "name": "radius_ly",
            "type": "double",
            "doc": "Radius of the galaxy in light years",
            "default": 0.0
          },
          {
            "name": "thickness_ly",
            "type": "double",
            "doc": "Thickness of the galaxy in light years",
            "default": 0.0
          },
          {
            "name": "num_stars",
            "type": "long",
            "doc": "Total number of star systems in the galaxy",
            "default": 0
          },
          {
            "name": "spiral_properties",
            "type": [
              "null",
              {
                "type": "record",
                "name": "SpiralProperties",
                "fields": [
                  {
                    "name": "num_arms",
                    "type": "int",
                    "doc": "Number of spiral arms",
                    "default": 0
                  },
                  {
                    "name": "arm_rotation",
                    "type": "double",
                    "doc": "Rotation factor for spiral arms",
                    "default": 0.0
                  },
                  {
                    "name": "arm_fuzziness",
                    "type": "double",
                    "doc": "Fuzziness factor for spiral arms",
                    "default": 0.0
                  },
                  {
                    "name": "pattern_speed_km_s_kpc",
                    "type": "double",
                    "doc": "Spiral arm pattern speed in km/s/kpc (Omega_p). Typical: 20-30 km/s/kpc. Arms rotate slower than stars (density wave theory).",
                    "default": 25.0
                  },
                  {
                    "name": "corotation_radius_kpc",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Corotation radius in kpc where stellar angular velocity equals pattern speed: Ω(R_CR) = Ω_p. Typical: 8-12 kpc for Milky Way."
                  },
                  {
                    "name": "inner_lindblad_resonance_kpc",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Inner Lindblad Resonance radius in kpc where: Ω - κ/m = Ω_p. Inner boundary of spiral arms."
                  },
                  {
                    "name": "outer_lindblad_resonance_kpc",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Outer Lindblad Resonance radius in kpc where: Ω + κ/m = Ω_p. Outer boundary of spiral arms."
                  },
                  {
                    "name": "potential_amplitude_kpc2_myr2",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Amplitude of spiral gravitational potential perturbation in kpc²/Myr² units. Typical: 200-500. Controls arm strength. Used in Φ_spiral = A × cos(m×θ - k_r×r - Ω_p×t)."
                  },
                  {
                    "name": "pitch_angle_deg",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Pitch angle of spiral arms in degrees. Typical: 10-25°. Used to calculate radial wavenumber k_r = m/(r×tan(pitch))."
                  },
                  {
                    "name": "scale_length_kpc",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Exponential scale length of galaxy disk in kpc. Typical: 3-5 kpc. Used for surface density Σ(r) = Σ_0 × exp(-r/R_d)."
                  },
                  {
                    "name": "circular_velocity_km_s",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null,
                    "doc": "Circular velocity for flat rotation curve in km/s. Calculated from V_c = Ω_p × R_CR at corotation. Typical: 180-250 km/s. Used for equilibrium initial velocities."
                  },
                  {
                    "name": "rotation_direction",
                    "type": {
                      "type": "enum",
                      "name": "ArmWindingDirection",
                      "symbols": ["CCW", "CW"]
                    },
                    "doc": "Spiral arm winding direction as viewed from galactic north. CCW = counter-clockwise (majority of observed galaxies), CW = clockwise.",
                    "default": "CCW"
                  }
                ]
              }
            ],
            "default": null,
            "doc": "Properties specific to spiral galaxies, null for other types"
          }
        ]
      },
      "default": {}
    },
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "GalaxyMetadata",
        "fields": [
          {
            "name": "generation_date",
            "type": "string",
            "doc": "ISO-8601 formatted date-time when the galaxy was generated",
            "default": ""
          },
          {
            "name": "generator_version",
            "type": "string",
            "doc": "Version of the generator software used",
            "default": ""
          },
          {
            "name": "description",
            "type": "string",
            "doc": "Human-readable description of the galaxy",
            "default": ""
          },
          {
            "name": "seed",
            "type": ["null", "long"],
            "doc": "PRNG seed used to generate this galaxy — same seed + same params reproduces an identical galaxy",
            "default": null
          },
          {
            "name": "performance_metrics",
            "type": {
              "type": "record",
              "name": "PerformanceMetrics",
              "fields": [
                {
                  "name": "num_systems",
                  "type": [
                    "null",
                    "long"
                  ],
                  "default": null,
                  "doc": "Total number of star systems included in this galaxy record"
                },
                {
                  "name": "generation_duration_ms",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "Elapsed time in milliseconds to generate the galaxy"
                },
                {
                  "name": "cpu_time_ms",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "CPU time consumed during generation in milliseconds"
                },
                {
                  "name": "memory_usage_mb",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "Peak memory usage during generation in megabytes"
                },
                {
                  "name": "avg_system_generation_ms",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "Average wall time per system in milliseconds"
                },
                {
                  "name": "systems_per_second",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "Throughput computed as num_systems divided by total wall time (converted to seconds)"
                },
                {
                  "name": "generated_bytes",
                  "type": [
                    "null",
                    "long"
                  ],
                  "default": null,
                  "doc": "Total bytes generated for all artifacts (data + images + metadata)"
                },
                {
                  "name": "generated_gb",
                  "type": [
                    "null",
                    "double"
                  ],
                  "default": null,
                  "doc": "Convenience field: generated_bytes converted to gigabytes (10^9 bytes)"
                }
              ]
            },
            "doc": "Performance metrics captured during galaxy generation",
            "default": {}
          }
        ]
      },
      "default": {}
    },
    {
      "name": "systems",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "StarSystem",
          "fields": [
            {
              "name": "system_id",
              "type": "string",
              "default": ""
            },
            {
              "name": "coordinates",
              "type": {
                "type": "record",
                "name": "Coordinates",
                "fields": [
                  {
                    "name": "x",
                    "type": "double",
                    "default": 0.0
                  },
                  {
                    "name": "y",
                    "type": "double",
                    "default": 0.0
                  },
                  {
                    "name": "z",
                    "type": "double",
                    "default": 0.0
                  }
                ]
              },
              "default": {}
            }
          ]
        }
      },
      "doc": "Array of star systems within the galaxy",
      "default": []
    },
    {
      "name": "coordinates",
      "type": "CosmosGenesis.properties.Coordinates"
    },
    {
      "name": "age_gyr",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Age of the galaxy in billions of years (Gyr)"
    },
    {
      "name": "total_stellar_mass_msun",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Total stellar mass in solar masses (integrated from star formation history)"
    },
    {
      "name": "gas_mass_msun",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Total gas mass in solar masses (ISM + molecular clouds)"
    },
    {
      "name": "sfr_msun_yr",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Star formation rate in solar masses per year"
    },
    {
      "name": "universe_time",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Universe time in Myr when this state was recorded (for temporal tracking)"
    },
    {
      "name": "morphology_params",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "JSON-encoded morphology parameters for spatial distribution (scale_length_kpc, scale_height_ly, num_arms, pitch_angle_deg, etc.)"
    },
    {
      "name": "velocity",
      "type": [
        "null",
        {
          "type": "record",
          "name": "GalaxyVelocity",
          "fields": [
            {
              "name": "x",
              "type": "double",
              "default": 0.0,
              "doc": "Velocity component in x direction (m/s)"
            },
            {
              "name": "y",
              "type": "double",
              "default": 0.0,
              "doc": "Velocity component in y direction (m/s)"
            },
            {
              "name": "z",
              "type": "double",
              "default": 0.0,
              "doc": "Velocity component in z direction (m/s)"
            }
          ],
          "doc": "Proper motion velocity vector of the galaxy through the universe (m/s)"
        }
      ],
      "default": null,
      "doc": "Galaxy proper motion velocity vector (null for static galaxies). Typical galaxy velocities range from 100-1000 km/s relative to local group."
    }
  ],
  "version": "1.0.0"
}
